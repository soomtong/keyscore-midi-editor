8:7 [Normal] ctrl-l -> cursor::NextBar
9:7 [Normal] alt-k -> note::TransposeUp
10:7 [Normal] alt-shift-l -> note::Lengthen
11:7 [Normal] enter -> mode::Step
12:7 [Normal] v -> view::Toggle
13:7 [Normal] r -> edit::Repeat
14:7 [Normal] / -> edit::Split
15:7 [Normal] cmd-j -> edit::Join
