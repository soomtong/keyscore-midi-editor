// vim 프리셋(REQ 5.8.1). default.json 위에 얹는 추가·덮어쓰기만 담는다.
// null 은 아래 레이어(default)의 같은 키를 해제한다(vim 이 다른 뜻으로 가져간 키, 또는 vim 시퀀스의 접두가 되는 키).
[
  {
    "context": "Normal",
    "bindings": {
      // 결정 대기: A1 shift-j -> note::OctaveDown / edit::Join, shift-k -> note::OctaveUp / note::ShowInfo
      // 결정 대기: A2 g a -> view::Toggle (g v / g i 와 REQ 불일치)
      // 결정 대기: A3 g c -> lane::Toggle, g shift-c -> mode::Controller
      // 결정 대기: A8 enter -> note::Audition (배치 뷰 clip::Open 과 겹침)
      // 결정 대기: A11 ; -> cursor::RepeatFind, , -> cursor::RepeatFindReverse
      // 결정 대기: A9/A10 숫자 길이 코드와 덮인 기본 키(w a b e / z)의 대체 키
      // 결정 대기: B20 ( ) 는 track::Prev/Next 로 배정, cursor::TrackUp/Down 은 키 없음
      "u": "edit::Undo",
      "shift-u": "edit::Redo",
      "ctrl-r": "edit::Redo",
      "y y": "edit::Copy",
      "p": "edit::PasteAfter",
      "shift-p": "edit::PasteBefore",
      "shift-x": "edit::DeleteBefore",
      "shift-d": "edit::DeleteToBarEnd",
      "shift-y": "edit::CopyBar",
      "shift-c": "edit::ChangeToBarEnd",
      "y y p": "edit::Repeat",
      "s": "edit::Split",
      "r": "edit::SetPitch",
      "z l": "view::ZoomIn",
      "z h": "view::ZoomOut",
      "shift-z": "view::ZoomToSelection",
      "z k": "view::ZoomVerticalIn",
      "z j": "view::ZoomVerticalOut",
      "z z": "view::CenterCursor",
      "i": "mode::Step",
      "a": "mode::StepAfterNote",
      "shift-i": "mode::StepAtBarStart",
      "shift-a": "mode::StepAtBarEnd",
      "shift-r": "mode::StepOverwrite",
      "w": "cursor::NextNote",
      "b": "cursor::PrevNote",
      "}": "cursor::NextClip",
      "{": "cursor::PrevClip",
      "g g": "cursor::ClipStart",
      "shift-g": "cursor::ClipEnd",
      "[": "cursor::OctaveDown",
      "]": "cursor::OctaveUp",
      "shift-w": "cursor::NextBeat",
      "shift-b": "cursor::PrevBeat",
      "e": "cursor::NoteEnd",
      "shift-e": "cursor::LastNoteEndInBar",
      "f": "cursor::NextSamePitch",
      "shift-f": "cursor::PrevSamePitch",
      "m a": "cursor::SetMark(a)",
      "' a": "cursor::JumpMark(a)",
      "` a": "cursor::JumpMark(a)",
      "m b": "cursor::SetMark(b)",
      "' b": "cursor::JumpMark(b)",
      "` b": "cursor::JumpMark(b)",
      "m c": "cursor::SetMark(c)",
      "' c": "cursor::JumpMark(c)",
      "` c": "cursor::JumpMark(c)",
      "m d": "cursor::SetMark(d)",
      "' d": "cursor::JumpMark(d)",
      "` d": "cursor::JumpMark(d)",
      "m e": "cursor::SetMark(e)",
      "' e": "cursor::JumpMark(e)",
      "` e": "cursor::JumpMark(e)",
      "m f": "cursor::SetMark(f)",
      "' f": "cursor::JumpMark(f)",
      "` f": "cursor::JumpMark(f)",
      "m g": "cursor::SetMark(g)",
      "' g": "cursor::JumpMark(g)",
      "` g": "cursor::JumpMark(g)",
      "m h": "cursor::SetMark(h)",
      "' h": "cursor::JumpMark(h)",
      "` h": "cursor::JumpMark(h)",
      "m i": "cursor::SetMark(i)",
      "' i": "cursor::JumpMark(i)",
      "` i": "cursor::JumpMark(i)",
      "m j": "cursor::SetMark(j)",
      "' j": "cursor::JumpMark(j)",
      "` j": "cursor::JumpMark(j)",
      "m k": "cursor::SetMark(k)",
      "' k": "cursor::JumpMark(k)",
      "` k": "cursor::JumpMark(k)",
      "m l": "cursor::SetMark(l)",
      "' l": "cursor::JumpMark(l)",
      "` l": "cursor::JumpMark(l)",
      "m m": "cursor::SetMark(m)",
      "' m": "cursor::JumpMark(m)",
      "` m": "cursor::JumpMark(m)",
      "m n": "cursor::SetMark(n)",
      "' n": "cursor::JumpMark(n)",
      "` n": "cursor::JumpMark(n)",
      "m o": "cursor::SetMark(o)",
      "' o": "cursor::JumpMark(o)",
      "` o": "cursor::JumpMark(o)",
      "m p": "cursor::SetMark(p)",
      "' p": "cursor::JumpMark(p)",
      "` p": "cursor::JumpMark(p)",
      "m q": "cursor::SetMark(q)",
      "' q": "cursor::JumpMark(q)",
      "` q": "cursor::JumpMark(q)",
      "m r": "cursor::SetMark(r)",
      "' r": "cursor::JumpMark(r)",
      "` r": "cursor::JumpMark(r)",
      "m s": "cursor::SetMark(s)",
      "' s": "cursor::JumpMark(s)",
      "` s": "cursor::JumpMark(s)",
      "m t": "cursor::SetMark(t)",
      "' t": "cursor::JumpMark(t)",
      "` t": "cursor::JumpMark(t)",
      "m u": "cursor::SetMark(u)",
      "' u": "cursor::JumpMark(u)",
      "` u": "cursor::JumpMark(u)",
      "m v": "cursor::SetMark(v)",
      "' v": "cursor::JumpMark(v)",
      "` v": "cursor::JumpMark(v)",
      "m w": "cursor::SetMark(w)",
      "' w": "cursor::JumpMark(w)",
      "` w": "cursor::JumpMark(w)",
      "m x": "cursor::SetMark(x)",
      "' x": "cursor::JumpMark(x)",
      "` x": "cursor::JumpMark(x)",
      "m y": "cursor::SetMark(y)",
      "' y": "cursor::JumpMark(y)",
      "` y": "cursor::JumpMark(y)",
      "m z": "cursor::SetMark(z)",
      "' z": "cursor::JumpMark(z)",
      "` z": "cursor::JumpMark(z)",
      "v": "select::VisualNote",
      "shift-v": "select::VisualTime",
      "ctrl-v": "select::VisualBlock",
      "=": "note::TransposeUp",
      "-": "note::TransposeDown",
      "shift-l": "note::Lengthen",
      ">": "note::Lengthen",
      "shift-h": "note::Shorten",
      "<": "note::Shorten",
      ")": "track::Next",
      "(": "track::Prev",
      "o": "track::NewBelow",
      "shift-o": "track::NewAbove",
      "shift-m": "track::ToggleMute",
      "shift-s": "track::ToggleSolo",
      "g t": "track::FocusList",
      "ctrl-space": "transport::Toggle",
      "ctrl-.": "transport::Panic",
      "/": "search::Open",
      "n": "search::Next",
      "shift-n": "search::Prev",
      "d": "operator::Delete",
      "y": "operator::Yank",
      "c": "operator::Change",
      "1": "operator::Count(1)",
      "2": "operator::Count(2)",
      "3": "operator::Count(3)",
      "4": "operator::Count(4)",
      "5": "operator::Count(5)",
      "6": "operator::Count(6)",
      "7": "operator::Count(7)",
      "8": "operator::Count(8)",
      "9": "operator::Count(9)",
      "m": null,
      "z": null
    }
  },
  {
    "context": "Normal > Operator",
    "bindings": {
      "a c": "object::AroundClip",
      "i b": "object::InnerBar",
      "i n": "object::InnerNote"
    }
  },
  {
    "context": "Step",
    "bindings": {
      // 결정 대기: B25 shift-~ -> step::TieLegato (기호 키 표기)
      "{": "step::OctaveOnce(-1)",
      "}": "step::OctaveOnce(1)",
      "shift-space": "step::HalfRest",
      "shift-backspace": "step::BackToBarStart",
      "shift-enter": "step::PreviewFromBar"
    }
  },
  {
    "context": "Normal > Arrangement",
    "bindings": {
      "shift-h": null,
      "shift-l": null
    }
  },
  {
    "context": "Normal > PianoRoll",
    "bindings": {
      "1": null,
      "2": null,
      "3": null,
      "4": null,
      "5": null,
      "6": null,
      "7": null,
      "b": null,
      "e": null,
      "n": null,
      "p": null,
      "shift-b": null,
      "shift-h": null,
      "shift-l": null
    }
  }
]
