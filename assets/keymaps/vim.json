// vim 프리셋(REQ 5.8.1). default.json 위에 얹는 추가·덮어쓰기만 담는다.
// null 은 아래 레이어(default)의 같은 키를 해제한다(vim 이 다른 뜻으로 가져간 키, 또는 vim 시퀀스의 접두가 되는 키).
// GPUI의 null(NoAction)은 같은 키의 같거나 얕은 컨텍스트 바인딩을 모두 가린다. 그래서 깊은 컨텍스트(Normal > PianoRoll 등)에서는
// null 대신 vim의 Normal 바인딩을 직접 건다(S2-T2 리뷰 1 지적 1).
[
  {
    "context": "Normal",
    "bindings": {
      // 결정됨(2026-10-17-keymap-conflicts.md, 2026-10-24). 반영 단계가 남은 것:
      //   A3 g c -> lane::Toggle, g shift-c -> mode::Controller (S6-T1)
      //   A10 g w 가사(S6), g i AI(S7)
      //   B20 ( ) 는 track::Prev/Next 로 배정, cursor::TrackUp/Down 은 키 없음
      // S3-T2가 채운 것: A2 g a, A8 enter(Normal > PianoRoll), A10 g b / g shift-b, A11 ; ,
      // S3-T3b가 채운 것: A1 shift-j / shift-k, A9 g 1 … g 7, g 0
      "g a": "view::Toggle",
      // A1: J 합치기, K 노트 정보. 옥타브 이동은 기본 프리셋의 alt-shift-j/k 를 쓴다.
      "shift-j": "edit::Join",
      "shift-k": "note::ShowInfo",
      // A9: 숫자는 카운트라 길이 코드는 g 접두로 옮긴다. 점음표는 기본 프리셋의 기호 키(! … &)를 쓴다.
      "g 1": "note::SetLength(whole)",
      "g 2": "note::SetLength(half)",
      "g 3": "note::SetLength(quarter)",
      "g 4": "note::SetLength(eighth)",
      "g 5": "note::SetLength(sixteenth)",
      "g 6": "note::SetLength(thirtysecond)",
      "g 7": "note::SetLength(sixtyfourth)",
      "g 0": "note::ResetLength",
      "g b": "select::Bar",
      "g shift-b": "select::Clip",
      ";": "cursor::RepeatFind",
      ",": "cursor::RepeatFindReverse",
      "u": "edit::Undo",
      "shift-u": "edit::Redo",
      "ctrl-r": "edit::Redo",
      "y y": "edit::Copy",
      "p": "edit::PasteAfter",
      "shift-p": "edit::PasteBefore",
      "shift-x": "edit::DeleteBefore",
      "shift-d": "edit::DeleteToBarEnd",
      "shift-y": "edit::CopyBar",
      "shift-c": "edit::ChangeToBarEnd",
      "y y p": "edit::Repeat",
      "s": "edit::Split",
      "r": "edit::SetPitch",
      "z l": "view::ZoomIn",
      "z h": "view::ZoomOut",
      "shift-z": "view::ZoomToSelection",
      "z k": "view::ZoomVerticalIn",
      "z j": "view::ZoomVerticalOut",
      "z z": "view::CenterCursor",
      "i": "mode::Step",
      "a": "mode::StepAfterNote",
      "shift-i": "mode::StepAtBarStart",
      "shift-a": "mode::StepAtBarEnd",
      "shift-r": "mode::StepOverwrite",
      "w": "cursor::NextNote",
      "b": "cursor::PrevNote",
      "}": "cursor::NextClip",
      "{": "cursor::PrevClip",
      "g g": "cursor::ClipStart",
      "shift-g": "cursor::ClipEnd",
      "[": "cursor::OctaveDown",
      "]": "cursor::OctaveUp",
      "shift-w": "cursor::NextBeat",
      "shift-b": "cursor::PrevBeat",
      "e": "cursor::NoteEnd",
      "shift-e": "cursor::LastNoteEndInBar",
      "f": "cursor::NextSamePitch",
      "shift-f": "cursor::PrevSamePitch",
      "m a": "cursor::SetMark(a)",
      "' a": "cursor::JumpMark(a)",
      "` a": "cursor::JumpMark(a)",
      "m b": "cursor::SetMark(b)",
      "' b": "cursor::JumpMark(b)",
      "` b": "cursor::JumpMark(b)",
      "m c": "cursor::SetMark(c)",
      "' c": "cursor::JumpMark(c)",
      "` c": "cursor::JumpMark(c)",
      "m d": "cursor::SetMark(d)",
      "' d": "cursor::JumpMark(d)",
      "` d": "cursor::JumpMark(d)",
      "m e": "cursor::SetMark(e)",
      "' e": "cursor::JumpMark(e)",
      "` e": "cursor::JumpMark(e)",
      "m f": "cursor::SetMark(f)",
      "' f": "cursor::JumpMark(f)",
      "` f": "cursor::JumpMark(f)",
      "m g": "cursor::SetMark(g)",
      "' g": "cursor::JumpMark(g)",
      "` g": "cursor::JumpMark(g)",
      "m h": "cursor::SetMark(h)",
      "' h": "cursor::JumpMark(h)",
      "` h": "cursor::JumpMark(h)",
      "m i": "cursor::SetMark(i)",
      "' i": "cursor::JumpMark(i)",
      "` i": "cursor::JumpMark(i)",
      "m j": "cursor::SetMark(j)",
      "' j": "cursor::JumpMark(j)",
      "` j": "cursor::JumpMark(j)",
      "m k": "cursor::SetMark(k)",
      "' k": "cursor::JumpMark(k)",
      "` k": "cursor::JumpMark(k)",
      "m l": "cursor::SetMark(l)",
      "' l": "cursor::JumpMark(l)",
      "` l": "cursor::JumpMark(l)",
      "m m": "cursor::SetMark(m)",
      "' m": "cursor::JumpMark(m)",
      "` m": "cursor::JumpMark(m)",
      "m n": "cursor::SetMark(n)",
      "' n": "cursor::JumpMark(n)",
      "` n": "cursor::JumpMark(n)",
      "m o": "cursor::SetMark(o)",
      "' o": "cursor::JumpMark(o)",
      "` o": "cursor::JumpMark(o)",
      "m p": "cursor::SetMark(p)",
      "' p": "cursor::JumpMark(p)",
      "` p": "cursor::JumpMark(p)",
      "m q": "cursor::SetMark(q)",
      "' q": "cursor::JumpMark(q)",
      "` q": "cursor::JumpMark(q)",
      "m r": "cursor::SetMark(r)",
      "' r": "cursor::JumpMark(r)",
      "` r": "cursor::JumpMark(r)",
      "m s": "cursor::SetMark(s)",
      "' s": "cursor::JumpMark(s)",
      "` s": "cursor::JumpMark(s)",
      "m t": "cursor::SetMark(t)",
      "' t": "cursor::JumpMark(t)",
      "` t": "cursor::JumpMark(t)",
      "m u": "cursor::SetMark(u)",
      "' u": "cursor::JumpMark(u)",
      "` u": "cursor::JumpMark(u)",
      "m v": "cursor::SetMark(v)",
      "' v": "cursor::JumpMark(v)",
      "` v": "cursor::JumpMark(v)",
      "m w": "cursor::SetMark(w)",
      "' w": "cursor::JumpMark(w)",
      "` w": "cursor::JumpMark(w)",
      "m x": "cursor::SetMark(x)",
      "' x": "cursor::JumpMark(x)",
      "` x": "cursor::JumpMark(x)",
      "m y": "cursor::SetMark(y)",
      "' y": "cursor::JumpMark(y)",
      "` y": "cursor::JumpMark(y)",
      "m z": "cursor::SetMark(z)",
      "' z": "cursor::JumpMark(z)",
      "` z": "cursor::JumpMark(z)",
      "v": "select::VisualNote",
      "shift-v": "select::VisualTime",
      "ctrl-v": "select::VisualBlock",
      "=": "note::TransposeUp",
      "-": "note::TransposeDown",
      "shift-l": "note::Lengthen",
      ">": "note::Lengthen",
      "shift-h": "note::Shorten",
      "<": "note::Shorten",
      ")": "track::Next",
      "(": "track::Prev",
      "o": "track::NewBelow",
      "shift-o": "track::NewAbove",
      "shift-m": "track::ToggleMute",
      "shift-s": "track::ToggleSolo",
      "g t": "track::FocusList",
      "ctrl-space": "transport::Toggle",
      "ctrl-.": "transport::Panic",
      "/": "search::Open",
      "n": "search::Next",
      "shift-n": "search::Prev",
      "d": "operator::Delete",
      "y": "operator::Yank",
      "c": "operator::Change",
      "1": "operator::Count(1)",
      "2": "operator::Count(2)",
      "3": "operator::Count(3)",
      "4": "operator::Count(4)",
      "5": "operator::Count(5)",
      "6": "operator::Count(6)",
      "7": "operator::Count(7)",
      "8": "operator::Count(8)",
      "9": "operator::Count(9)",
      "m": null,
      "z": null
    }
  },
  {
    "context": "Normal > Operator",
    "bindings": {
      // Esc = 통상의 취소(A13 결정): 오퍼레이터 대기·카운트 비움
      "escape": "operator::Cancel",
      "a c": "object::AroundClip",
      "i b": "object::InnerBar",
      "i n": "object::InnerNote"
    }
  },
  {
    "context": "Step",
    "bindings": {
      // B25 결정: step::TieLegato 의 vim 키는 비워 둔다(shift-~ 는 ~ 와 같은 글자라 표기할 수 없다).
      "{": "step::OctaveOnce(-1)",
      "}": "step::OctaveOnce(1)",
      "shift-space": "step::HalfRest",
      "shift-backspace": "step::BackToBarStart",
      "shift-enter": "step::PreviewFromBar"
    }
  },
  {
    "context": "Normal > Arrangement",
    "bindings": {
      "shift-h": "note::Shorten",
      "shift-l": "note::Lengthen",
      // A1: 기본 프리셋의 이 컨텍스트 shift-j/k(선택 넓히기)가 Normal 의 vim 바인딩을 가리지 않게 다시 건다.
      "shift-j": "edit::Join",
      "shift-k": "note::ShowInfo"
    }
  },
  {
    "context": "Normal > PianoRoll",
    "bindings": {
      // A8: 피아노롤의 enter 는 노트 듣기(배치 뷰 enter 는 clip::Open 상속)
      "enter": "note::Audition",
      "1": "operator::Count(1)",
      "2": "operator::Count(2)",
      "3": "operator::Count(3)",
      "4": "operator::Count(4)",
      "5": "operator::Count(5)",
      "6": "operator::Count(6)",
      "7": "operator::Count(7)",
      "b": "cursor::PrevNote",
      "e": "cursor::NoteEnd",
      "n": "search::Next",
      "p": "edit::PasteAfter",
      "shift-b": "cursor::PrevBeat",
      "shift-h": "note::Shorten",
      "shift-l": "note::Lengthen",
      "shift-j": "edit::Join",
      "shift-k": "note::ShowInfo"
    }
  }
]
